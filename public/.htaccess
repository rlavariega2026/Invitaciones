Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /invitaciones/

  # In .htaccess, use a relative target so Apache resolves it inside this folder.
  RewriteRule ^$ index.html [END]

  # Keep existing assets and files untouched.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [END]

  # Send application routes to the built entry point.
  RewriteRule ^ index.html [END]
</IfModule>
